# List every env var here with a placeholder value. Never put real values in this file.
# Copy to .env for local development: cp .env.example .env

# --- Demo device (seeded into the database on server start) ---
# The scooter sends this ID in the URL and this key in the X-Device-Key header.
DEVICE_ID=scooter-001
DEVICE_API_KEY=replace-with-a-long-random-string
# What the hardware device is attached to: power_tool | chainsaw | boat | scooter | other
DEVICE_KIND=power_tool
DEVICE_NAME=Angle grinder
# Who uses it and where. Only used when the device is created; edit them in the app after that.
DEVICE_OPERATOR=Tomas
DEVICE_SITE=Workshop
# true = tell the equipment to lock while required gear is missing (needs lock hardware)
DEVICE_AUTO_LOCK=false

# --- Server ---
PORT=3000
# SQLite file. On Render/Railway point this at a persistent disk to keep history across deploys.
DATABASE_PATH=./data/helmetto.db
# Enables POST /api/demo, the in-app Demo panel and two simulated devices (chainsaw, boat).
# Default: true locally, false in production.
DEMO_MODE=true

# --- Simulator (npm run simulate) ---
# API to send mock telemetry to. Default: http://localhost:$PORT
SIM_URL=http://localhost:3000
